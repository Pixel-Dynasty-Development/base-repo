{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Testimonials",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "author", "quote"],
    "properties": {
      "id": { "type": "string" },
      "author": { "type": "string" },
      "role": { "type": "string" },
      "company": { "type": "string" },
      "quote": { "type": "string" },
      "date": { "type": "string", "format": "date" },
      "rating": { "type": "integer", "minimum": 1, "maximum": 5 }
    },
    "additionalProperties": false
  }
}