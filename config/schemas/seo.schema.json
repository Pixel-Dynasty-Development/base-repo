{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SEO Config",
  "type": "object",
  "required": ["id", "siteTitle", "canonicalHost"],
  "properties": {
    "id": { "type": "string" },
    "siteTitle": { "type": "string" },
    "titleTemplate": { "type": "string" },
    "defaultDescription": { "type": "string" },
    "defaultImage": { "type": "string" },
    "canonicalHost": { "type": "string", "format": "uri" },
    "openGraph": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "locale": { "type": "string" },
        "siteName": { "type": "string" }
      },
      "additionalProperties": false
    },
    "twitter": {
      "type": "object",
      "properties": {
        "card": { "type": "string" },
        "site": { "type": "string" },
        "creator": { "type": "string" }
      },
      "additionalProperties": false
    },
    "robots": {
      "type": "object",
      "properties": {
        "index": { "type": "boolean" },
        "follow": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "structuredData": { "type": "object" },
    "pageDefaults": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "title": { "type": ["string", "null"] },
            "description": { "type": ["string", "null"] },
            "image": { "type": ["string", "null"] },
            "canonical": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "og": { "type": "object" },
        "twitter": { "type": "object" }
      },
      "additionalProperties": false
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}