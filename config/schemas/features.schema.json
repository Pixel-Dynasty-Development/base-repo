    "id": { "type": "string" },
    "darkMode": { "type": "boolean" },
    "onboarding": { "type": "boolean" },
    "blog": { "type": "boolean" },
    "testimonials": { "type": "boolean" },
    "contactForm": { "type": "boolean" },
    "newsletter": { "type": "boolean" },
    "onlineOrdering": { "type": "boolean" },
    "shop": { "type": "boolean" },
    "serviceListings": { "type": "boolean" },
    "faqs": { "type": "boolean" },
    "pricingTable": { "type": "boolean" },
    "featureDescriptions": {
      "type": "object",
